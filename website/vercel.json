{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install --include=optional",
  "devCommand": "npm run dev",
  "env": {
    "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
  },
  "crons": [
    {
      "path": "/api/admin/metrics",
      "schedule": "0 0 * * *"
    }
  ]
}