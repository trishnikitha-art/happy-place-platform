  "replacement_workflow": {
    "description": "When Taylor uploads a replacement photo",
    "steps": [
      "1. Taylor drops new photo in 📥 Incoming Uploads",
      "2. AI detects which production image to replace (based on project context)",
      "3. System moves new original to _System/Originals/[Project]/",
      "4. System increments version: v1 → v2",
      "5. System moves current production original to _System/History/Previous Versions/",
      "6. System creates rollback entry in _System/History/Rollback/",
      "7. System processes new original (enhance, responsive, metadata)",
      "8. System moves to _System/Processing/Ready for Review/",
      "9. Taylor reviews and approves",
      "10. System deploys to website",
      "11. System updates version history",
      "12. System sends confirmation email"
    ],
    "rollback_workflow": [
      "1. Taylor selects 'Restore Previous Version'",
      "2. System retrieves previous original from _System/History/Rollback/",
      "3. System restores to _System/Originals/[Project]/",
      "4. System re-processes and deploys",
      "5. System updates version history",
      "6. System sends confirmation email"
    ]
  },
  "identity_principles": {
    "stable_ids": "Never change, even if image is replaced",
    "version_tracking": "Each replacement increments version number",
    "rollback": "Always preserve previous version for instant rollback",
    "deterministic": "Replacement always targets specific stable_id, never arbitrary",
    "website_specification": "Current website defines the initial stable_ids"
  }
}
